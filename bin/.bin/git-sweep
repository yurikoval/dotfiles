#!/bin/zsh

set -u

apply=false
assume_yes=false

usage() {
  cat <<'EOF'
usage: git sweep [--apply] [--yes]

Fetch every branch from origin, then select local branches that are either:
  - merged into origin's default branch, or
  - free of commits not present on their origin branch.

Use --apply to review every local branch and change the selection interactively.
The default mode is a dry run; --yes removes the default selection without
prompting. Dirty worktrees and protected branches cannot be selected. Remote
branches are never deleted.
EOF
}

while (( $# )); do
  case "$1" in
    --apply) apply=true ;;
    -y|--yes) apply=true; assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    *) print -u2 -r -- "git sweep: unknown option: $1"; usage >&2; exit 2 ;;
  esac
  shift
done

repo=$(git rev-parse --show-toplevel 2>/dev/null) || {
  print -u2 -- "git sweep: not inside a Git repository"
  exit 1
}

git remote get-url origin >/dev/null 2>&1 || {
  print -u2 -- "git sweep: this repository has no origin remote"
  exit 1
}

print -- "Fetching origin..."
git fetch --prune origin '+refs/heads/*:refs/remotes/origin/*' || exit $?

default_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
if [[ -z "$default_ref" ]]; then
  default_branch=$(git ls-remote --symref origin HEAD 2>/dev/null |
    awk '$1 == "ref:" { sub("refs/heads/", "", $2); print $2; exit }')
  default_ref="refs/remotes/origin/$default_branch"
fi

if [[ -z "${default_branch:-}" ]]; then
  default_branch=${default_ref#refs/remotes/origin/}
fi

if [[ -z "$default_branch" ]] || ! git show-ref --verify --quiet "$default_ref"; then
  print -u2 -- "git sweep: could not determine origin's default branch"
  exit 1
fi

common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
if [[ "${common:t}" == ".git" ]]; then
  main_worktree="${common:h}"
else
  main_worktree="$repo"
fi

typeset -A worktrees
worktree_path=""
while IFS= read -r line; do
  case "$line" in
    'worktree '*) worktree_path=${line#worktree } ;;
    'branch refs/heads/'*) worktrees[${line#branch refs/heads/}]=$worktree_path ;;
  esac
done < <(git worktree list --porcelain)

safe_reason() {
  local branch=$1 upstream local_only

  if git merge-base --is-ancestor "refs/heads/$branch" "$default_ref" 2>/dev/null; then
    print -r -- "merged into origin/$default_branch"
    return 0
  fi

  upstream=$(git for-each-ref --format='%(upstream)' "refs/heads/$branch")
  if [[ "$upstream" != refs/remotes/origin/* ]]; then
    upstream="refs/remotes/origin/$branch"
  fi
  git show-ref --verify --quiet "$upstream" || return 1

  local_only=$(git rev-list --count "$upstream..refs/heads/$branch") || return 1
  if (( local_only == 0 )); then
    print -r -- "no local-only commits relative to ${upstream#refs/remotes/}"
    return 0
  fi
  return 1
}

typeset -a candidates candidate_tips decisions selectable safe_defaults
for ref in ${(f)"$(git for-each-ref --format='%(refname)' refs/heads)"}; do
  branch=${ref#refs/heads/}
  wt_path=${worktrees[$branch]:-}
  decision=keep
  can_select=true
  safe_default=false

  if [[ "$branch" == "$default_branch" ]]; then
    reason="origin's default branch"
    can_select=false
  elif [[ -n "$wt_path" && ( "$wt_path" == "$repo" || "$wt_path" == "$main_worktree" ) ]]; then
    reason="checked out in protected worktree $wt_path"
    can_select=false
  elif [[ -n "$wt_path" ]]; then
    wt_status=$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null) || {
      reason="could not inspect worktree $wt_path"
      can_select=false
    }
    if [[ "$can_select" == true && -n "$wt_status" ]]; then
      reason="worktree $wt_path has changes"
      can_select=false
    elif [[ "$can_select" == true ]]; then
      if reason=$(safe_reason "$branch"); then
        decision=remove
        safe_default=true
        reason="$reason; worktree $wt_path"
      else
        reason="has local commits not merged or preserved on origin; worktree $wt_path"
      fi
    fi
  elif reason=$(safe_reason "$branch"); then
    decision=remove
    safe_default=true
  else
    reason="has local commits not merged or preserved on origin"
  fi

  candidates+=("$branch")
  candidate_tips+=("$(git rev-parse "refs/heads/$branch")")
  decisions+=("$decision")
  selectable+=("$can_select")
  safe_defaults+=("$safe_default")
  printf '%-6s %s (%s)\n' "$decision" "$branch" "$reason"
done

count=${#candidates}
if (( count == 0 )); then
  print -- "No local branches found."
  exit 0
fi

selected=0
for decision in $decisions; do
  [[ "$decision" == remove ]] && (( selected++ ))
done

if [[ "$apply" != true ]]; then
  print -- "Dry run: $selected of $count branch(es) selected by default. Re-run with --apply."
  exit 0
fi

choose_candidates() {
  local current=1 top=1 key row marker i
  local visible=$(( ${LINES:-24} - 2 ))
  (( visible < 1 )) && visible=1
  (( visible > count )) && visible=$count

  print -- "Use ↑/↓ to move, Space to toggle, Enter to apply, or q to cancel."
  while true; do
    (( current < top )) && top=$current
    (( current >= top + visible )) && top=$(( current - visible + 1 ))

    for (( i = top; i < top + visible; i++ )); do
      [[ "${selectable[$i]}" == true ]] && marker="" || marker=" (protected)"
      printf -v row '  %-6s %s%s' "${decisions[$i]}" "${candidates[$i]}" "$marker"
      printf '\r\033[2K\033[?7l'
      (( i == current )) && printf '\033[7m'
      printf '%s' "$row"
      (( i == current )) && printf '\033[K\033[0m'
      printf '\033[?7h\r\n'
    done

    IFS= read -rsk 1 key || return 1
    case "$key" in
      ' ')
        if [[ "${selectable[$current]}" == true ]]; then
          [[ "${decisions[$current]}" == remove ]] && decisions[$current]=keep || decisions[$current]=remove
        fi
        ;;
      $'\n'|$'\r') return 0 ;;
      q|Q) return 1 ;;
      $'\e')
        if IFS= read -rsk 1 -t 0.1 key && [[ "$key" == '[' || "$key" == 'O' ]] && IFS= read -rsk 1 -t 0.1 key; then
          case "$key" in
            A) (( current = current == 1 ? count : current - 1 )) ;;
            B) (( current = current == count ? 1 : current + 1 )) ;;
          esac
        fi
        ;;
    esac
    printf '\033[%dA' "$visible"
  done
}

if [[ "$assume_yes" != true ]]; then
  if [[ ! -t 0 || ! -t 1 ]]; then
    print -u2 -- "git sweep: interactive selection requires a terminal; use --yes"
    exit 2
  fi
  choose_candidates || {
    print -- "No branches removed."
    exit 0
  }
fi

selected=0
for decision in $decisions; do
  [[ "$decision" == remove ]] && (( selected++ ))
done

removed=0
for (( i = 1; i <= count; i++ )); do
  branch=${candidates[$i]}
  [[ "${decisions[$i]}" == keep ]] && continue
  expected_tip=${candidate_tips[$i]}
  wt_path=${worktrees[$branch]:-}

  if [[ "$(git rev-parse -q --verify "refs/heads/$branch" 2>/dev/null)" != "$expected_tip" ]]; then
    print -u2 -r -- "skip   $branch (branch changed since analysis)"
    continue
  fi
  if [[ "${safe_defaults[$i]}" == true ]] && ! safe_reason "$branch" >/dev/null; then
    print -u2 -r -- "skip   $branch (no longer safe to remove)"
    continue
  fi
  if [[ -n "$wt_path" ]]; then
    if [[ "$(git -C "$wt_path" symbolic-ref --quiet --short HEAD 2>/dev/null)" != "$branch" ]]; then
      print -u2 -r -- "skip   $branch (worktree changed branches)"
      continue
    fi
    wt_status=$(git -C "$wt_path" status --porcelain --untracked-files=all 2>/dev/null) || {
      print -u2 -r -- "skip   $branch (could not re-inspect worktree)"
      continue
    }
    if [[ -n "$wt_status" ]]; then
      print -u2 -r -- "skip   $branch (worktree gained changes)"
      continue
    fi
    git worktree remove "$wt_path" || {
      print -u2 -r -- "skip   $branch (could not remove worktree $wt_path)"
      continue
    }
  fi
  git branch -D -- "$branch" && (( removed++ ))
done

print -- "Removed $removed of $selected selected branch(es)."
